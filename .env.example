# Configuración del Revisor de Natación Colsubsidio
# Copia este archivo como '.env' en este mismo directorio y completa los valores.

# --- TELEGRAM BOT CONFIGURATION ---
# Token de tu bot de Telegram obtenido a través de @BotFather
TELEGRAM_TOKEN=tu_telegram_bot_token_aqui

# Tu ID de usuario de Telegram (o ID de grupo/canal) obtenido de @userinfobot o similar
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui

# --- COLSUBSIDIO SESSION CONFIGURATION ---
# Credenciales de usuario y clave de Colsubsidio para inicio de sesión automático con Playwright
COLSUBSIDIO_USER=tu_usuario_o_documento_aqui
COLSUBSIDIO_PASS=tu_clave_aqui

# Valor de la cookie 'sistema' obtenida del navegador al estar logueado en Colsubsidio
COLSUBSIDIO_SISTEMA_COOKIE=tu_cookie_sistema_aqui

# Valor de la cookie/token 'Csrf-Token' obtenida del navegador
COLSUBSIDIO_CSRF_TOKEN=tu_csrf_token_aqui
